# Copie para .env (make up faz isso na primeira vez). Nunca versione o .env.
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# Usadas fora do docker compose (testes locais). No compose, os hosts são sobrescritos.
DATABASE_URL=postgresql+psycopg://rfp:rfp@localhost:5432/rfp
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rfp
MINIO_SECRET_KEY=rfp-secret-local

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=rfp-automation@localhost

# fake = respostas fixas, sem custo. Troque quando o adaptador real existir (sprint 6).
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake

# Autenticação. Login local (e-mail e senha) só para testes: em produção é recusado.
AUTH_LOCAL_ENABLED=true
AUTH_OIDC_ENABLED=false
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
# Senha dos usuários criados pelo seed (admin@, analista@, validador@, conhecimento@rfp.local)
SEED_PASSWORD=rfp-local-123
